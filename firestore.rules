rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'player'
        && request.resource.data.balance == 777
        && request.resource.data.xp == 0;
      allow update: if admin()
        || (
          isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && (
            onlyChanged(['displayName', 'photoUrl', 'updatedAt'])
            || (
              onlyChanged(['balance', 'xp', 'dailyStreak', 'lastBonusAt', 'achievements', 'updatedAt'])
              && request.resource.data.balance is int
              && request.resource.data.balance >= 0
              && request.resource.data.balance <= resource.data.balance + 1200
              && request.resource.data.xp is int
              && request.resource.data.xp >= resource.data.xp
              && request.resource.data.xp <= resource.data.xp + 100
            )
          )
        );
      allow delete: if false;
    }

    match /rewards/{rewardId} {
      allow get, list: if signedIn() && (resource.data.active == true || admin());
      allow create, delete: if admin();
      allow update: if admin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && resource.data.stock > 0
          && request.resource.data.stock == resource.data.stock - 1
        );
    }

    match /announcements/{announcementId} {
      allow get, list: if signedIn() && (resource.data.active == true || admin());
      allow create, update, delete: if admin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if admin();
    }

    match /gameSessions/{sessionId} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.coinDelta is int
        && request.resource.data.coinDelta >= -5000
        && request.resource.data.coinDelta <= 1200;
      allow update, delete: if false;
    }

    match /coinLedger/{ledgerId} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount >= -100000
        && request.resource.data.amount <= 1200;
      allow update, delete: if false;
    }
  }
}
